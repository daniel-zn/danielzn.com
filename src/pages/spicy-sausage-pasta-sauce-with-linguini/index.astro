---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Spicy Sausage Pasta Sauce with Linguini"
  description="Spicy sausage pasta sauce with linguini."
  image="/images/img_1055.jpg"
>
  <div class="wrap wrap--narrow">
    <header class="page-head">
      <h1>Spicy Sausage Pasta Sauce with Linguini</h1>
    </header>
    <article class="project">
      <p><em>Description about pasta</em></p>

      <h2>Ingredients</h2>
      <div class="ingredients">
        <div class="ingredient">
          <img
            src="/images/canned-tomatoes.jpg"
            alt="Canned tomatoes"
            width="530"
            height="612"
            loading="lazy"
            decoding="async"
          />
          <p>1 Can of Diced and Spiced Tomatoes</p>
        </div>
        <div class="ingredient">
          <img
            src="/images/spicy-italian-sausages-1.png"
            alt="Spicy Italian sausages"
            width="900"
            height="620"
            loading="lazy"
            decoding="async"
          />
          <p>2 Spicy Italian Sausages</p>
        </div>
        <div class="ingredient">
          <img
            src="/images/fettucine.jpg"
            alt="Fettuccine pasta"
            width="1500"
            height="429"
            loading="lazy"
            decoding="async"
          />
          <p>1 Box of Pappardelle or Fettuccine Pasta</p>
        </div>
      </div>
      <ul>
        <li>1 Onion</li>
        <li>3 Garlic Cloves</li>
        <li>1 Red Bell Pepper</li>
        <li>4 Cremini Mushrooms</li>
        <li>1/2 Bottle of Dry Red Wine</li>
        <li>Olive Oil</li>
        <li>Salt/Black Pepper/Basil</li>
      </ul>

      <h2>Apparatus</h2>
      <ul>
        <li>Cooking Pan – <em>wide and flat, 2 inch deep</em></li>
        <li>Tall Pot</li>
        <li>Strainer</li>
        <li>Wooden Spoon</li>
      </ul>

      <h2>Instructions</h2>
      <ol>
        <li>Finely chop the <em>onion</em>, <em>garlic</em> and <em>red bell pepper</em>.</li>
        <li>Remove <em>mushroom</em> stems and chop the <em>mushroom</em> heads into thick slices.</li>
        <li>Add a tablespoon of <em>olive oil</em> to <em>cooking pan</em> and set stove to medium-high.</li>
        <li>Cook <em>onion</em> and <em>garlic</em> in pan for 5 minutes.</li>
        <li>Add <em>red bell pepper</em> to pan and continue cooking for 10 minutes.</li>
        <li>Remove <em>sausages</em> from their casings and pull them apart into small pieces about the size of a grape.</li>
        <li>Add <em>sausage</em> pieces to pan and continue cooking for 5 minutes.</li>
        <li>Add <em>mushrooms</em> and continue cooking for 5 minutes.</li>
        <li>Boil water in <em>tall pot.</em></li>
        <li>Empty <em>can of tomatoes</em> in pan and add <em>black pepper</em>.</li>
        <li>Break up <em>tomato</em> pieces with <em>wooden spoon.</em></li>
        <li>Pour <em>1/2 bottle of red wine</em> into pan.</li>
        <li>Mix and add <em>salt</em> to taste.</li>
        <li>Put <em>pasta</em> in <em>tall pot</em>, strain after 10-12 minutes.</li>
        <li>Set stove to high and cook until tomato juice in pan is half the depth of the pan. (If too much water is boiled off, add more red wine).</li>
        <li>Remove <em>pan</em> from heat and add <em>basil</em> to taste.</li>
      </ol>
    </article>
  </div>
</BaseLayout>
