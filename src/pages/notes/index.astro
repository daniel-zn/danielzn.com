---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { courses, courseSlug, groupCourses } from '../../data/site';

const groups = groupCourses(courses);
---

<BaseLayout
  title="Notes"
  description="These are a collection of the notes I’ve created for my university courses. They consist of diagrams and concise definitions of relevant terminology."
>
  <div class="wrap">
    <header class="page-head">
      <h1>Notes</h1>
      <p class="lede">
        These are a collection of the notes I’ve created for my university courses. They consist of diagrams and concise definitions of relevant terminology.
      </p>
    </header>
    {
      groups.map((group) => (
        <section class="note-group">
          <h2>{group.prefix}</h2>
          <div class="notes">
            {group.items.map((course) => (
              <a class="note" id={courseSlug(course.code)} href={course.href}>
                <span class="note-code">{course.code}</span>
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>
