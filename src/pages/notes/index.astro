---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { courses, courseSlug, groupCourses } from '../../data/site';

const groups = groupCourses(courses);
---

<BaseLayout
  title="Notes"
  description="These are a collection of the notes I’ve created for my university courses. They consist of diagrams and concise definitions of relevant terminology."
>
  <div class="wrap">
    <header class="page-head">
      <h1>Notes</h1>
      <p class="lede">
        These are a collection of the notes I’ve created for my university courses. They consist of diagrams and concise definitions of relevant terminology.
      </p>
    </header>
    {
      groups.map((group) => (
        <section class="note-group">
          <h2>{group.prefix}</h2>
          <div class="notes">
            {group.items.map((course) => (
              <article class="note" id={courseSlug(course.code)}>
                <p class="note-code">{course.code}</p>
                <h3 class="note-title">{course.title}</h3>
                <p class="note-brief">{course.brief}</p>
                <p class="note-download">
                  <a href={course.href}>Download notes (PDF)</a>
                </p>
              </article>
            ))}
          </div>
        </section>
      ))
    }
    <p class="note-source">
      Course titles and briefs restated from the UBC Academic Calendar 2026/27, Vancouver campus.
    </p>
  </div>
</BaseLayout>
