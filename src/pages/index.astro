---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeBand from '../components/HomeBand.astro';
import {
  aboutHeading,
  courseSlug,
  courses,
  heroHeading,
  heroLede,
  personalSections,
  projectSection,
} from '../data/site';
---

<BaseLayout description={heroLede}>
  <section class="hero">
    <div class="hero-inner">
      <p class="hero-kicker">{aboutHeading}</p>
      <h1>{heroHeading}</h1>
      <p><strong>{heroLede}</strong></p>
      <a class="btn" href="/engineer/">Engineer</a>
    </div>
    <div class="hero-media">
      <img
        src="/images/project-collection.jpg"
        alt=""
        width="5120"
        height="2160"
        fetchpriority="high"
      />
    </div>
  </section>

  <HomeBand {...projectSection} alt />

  <section class="band">
    <div class="wrap">
      <h2 class="band-title">
        <a href="/notes/">Notes</a>
      </h2>
      <ul class="note-chips">
        {
          courses.map((course) => (
            <li>
              <a href={`/notes/#${courseSlug(course.code)}`}>{course.code}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    personalSections.map((section, index) => (
      <HomeBand {...section} secondary alt={index % 2 === 0} />
    ))
  }
</BaseLayout>
