---
import { imageSize } from '../data/images';

interface Props {
  href?: string;
  image: string;
  title: string;
  year?: string;
  alt: string;
  heading?: 'h2' | 'h3';
}

const { href, image, title, year, alt, heading = 'h2' } = Astro.props;
const Wrap = href ? 'a' : 'div';
const Heading = heading;
const size = imageSize(image);
---

<article class:list={['card', { 'card-static': !href }]}>
  <Wrap class="card-inner" href={href}>
    <div class="card-media">
      <img
        src={image}
        alt={alt}
        width={size.width}
        height={size.height}
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="card-copy">
      <Heading>{title}</Heading>
      {year && <p class="year">{year}</p>}
    </div>
  </Wrap>
</article>
